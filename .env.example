# -----------------------------------------------------------------------------
# SEO Audit Tool — API (Laravel). Copy to .env and run `php artisan key:generate`.
# Values below work as-is with Laravel Sail (Docker). Never commit your .env.
# -----------------------------------------------------------------------------

APP_NAME="SEO Audit Tool"
APP_ENV=local
APP_KEY=
# Always false in production: with debug on, error pages expose internals.
APP_DEBUG=true
APP_URL=http://localhost
# Host port for the API container (Sail).
APP_PORT=80

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL container started by Sail) ------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=seo_audit
DB_USERNAME=sail
# Local development password for the MySQL container only. Use a strong one in production.
DB_PASSWORD=password

# --- Stateless JSON API: no sessions or cookies are used ----------------------
SESSION_DRIVER=array

# --- Queue and cache (Redis container started by Sail) -----------------------
QUEUE_CONNECTION=redis
# Must be greater than the longest job timeout (150 s), or a slow job could run twice.
REDIS_QUEUE_RETRY_AFTER=300
DB_QUEUE_RETRY_AFTER=300
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- CORS: other origins allowed to call the API from a browser --------------
# The React app is served from this same origin and needs no entry here.
# Example: CORS_ALLOWED_ORIGINS=https://panel.example.com,https://otra.example.com
CORS_ALLOWED_ORIGINS=

# --- Google PageSpeed Insights (optional) -------------------------------------
# Without a key the performance section is reported as "not run" and its weight
# is excluded from the score. Free key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
PAGESPEED_STRATEGY=mobile
PAGESPEED_TIMEOUT=90

# --- Audit limits (all optional, defaults shown) ------------------------------
AUDIT_USER_AGENT="SEO-Audit-Tool/1.0 (+https://github.com/IvanChesa/seo-audit-tool)"
AUDIT_CONNECT_TIMEOUT=5
AUDIT_FETCH_TIMEOUT=15
# 2 MB
AUDIT_MAX_PAGE_BYTES=2097152
AUDIT_MAX_REDIRECTS=5
AUDIT_ALLOWED_PORTS=80,443,8080,8443
AUDIT_MAX_LINKS_CHECKED=30
AUDIT_LINK_CONCURRENCY=5
AUDIT_LINK_TIMEOUT=8
AUDIT_CRAWL_FILES_TIMEOUT=8
AUDIT_SNAPSHOT_TTL_MINUTES=60

# Rate limits per client IP.
AUDIT_RATE_LIMIT_PER_MINUTE=10
AUDIT_RATE_LIMIT_PER_DAY=200
API_RATE_LIMIT_PER_MINUTE=120

# Housekeeping done by `php artisan audits:prune` (scheduled hourly):
# audits unfinished after AUDIT_STALE_AFTER_MINUTES are marked as failed, and
# audits older than AUDIT_RETENTION_DAYS are deleted (0 = keep the history forever).
AUDIT_RETENTION_DAYS=0
AUDIT_STALE_AFTER_MINUTES=15
