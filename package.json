{
  "name": "seo-audit-tool",
  "private": true,
  "version": "1.0.0",
  "description": "Auditoría SEO on-page: API en Laravel e interfaz en React servidas por la misma aplicación.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings resources/js vite.config.js",
    "format": "prettier --write resources/js resources/css vite.config.js",
    "format:check": "prettier --check resources/js resources/css vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "laravel-vite-plugin": "^3.2.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "vite": "^8.1.1",
    "vitest": "^5.0.1"
  }
}
